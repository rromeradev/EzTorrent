<c:AppWindow x:Class="EzTorrent.Desktop.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:EzTorrent.Desktop.Controls" xmlns:l="clr-namespace:EzTorrent.Desktop.Localization"
  Title="EzTorrent" Width="1120" Height="740" MinWidth="800" MinHeight="560" ShowMinimize="True" ShowMaximize="True" WindowStartupLocation="CenterScreen" Closing="OnClosing">
  <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid Margin="16,24,12,18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{l:Loc Transfers}" Style="{StaticResource MutedText}" Margin="12,0,0,16" />
        <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="12"><DockPanel><TextBlock Text="0" DockPanel.Dock="Right" Margin="12,0,0,0" /><TextBlock Text="{l:Loc AllTorrents}" FontWeight="SemiBold" /></DockPanel></Border>
        <Button Grid.Row="3" Content="{l:Loc Preferences}" Click="OpenPreferences" HorizontalContentAlignment="Left" Padding="12,9" />
      </Grid>
      <Grid Grid.Column="1" Margin="16,24,26,18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24"><TextBlock Text="{l:Loc AllTorrents}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="{l:Loc Subtitle}" Margin="0,8,0,0" Style="{StaticResource MutedText}" /></StackPanel>
        <Button Grid.Row="1" Content="{l:Loc AddTorrent}" IsEnabled="False" ToolTip="{l:Loc EngineHint}" ToolTipService.ShowOnDisabled="True" Padding="16,9" HorizontalAlignment="Left" Margin="0,0,0,20" />
        <Grid Grid.Row="2">
          <ListBox ItemsSource="{Binding Downloads}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="{l:Loc Cards}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate><Border Width="280" Padding="20" Margin="0,0,12,12" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,8,0,0" /><ProgressBar Value="{Binding Progress}" Maximum="1" Margin="0,20,0,10" /><DockPanel><TextBlock Text="{Binding DownloadSpeed}" /><TextBlock Text="{Binding UploadSpeed}" HorizontalAlignment="Right" /></DockPanel></StackPanel>
            </Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Border CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" IsHitTestVisible="False">
              <Border Width="76" Height="76" CornerRadius="24" Background="{DynamicResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center"><TextBlock Text="↓" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" /></Border>
              <TextBlock Text="{l:Loc EmptyTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,12" /><TextBlock Text="{l:Loc EmptyBody}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="{l:Loc PrivacyNote}" Margin="0,16,0,0" Style="{StaticResource MutedText}" FontSize="12" />
      </Grid>
    </Grid>
    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="20,0"><DockPanel VerticalAlignment="Center"><TextBlock Text="{l:Loc NoTransfers}" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="12" /><TextBlock Text="{l:Loc NoEngine}" Style="{StaticResource MutedText}" FontSize="12" /></DockPanel></Border>
  </Grid>
</c:AppWindow>
