<c:AppWindow x:Class="EzTorrent.Desktop.Views.PreferencesWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="clr-namespace:EzTorrent.Desktop.Localization" xmlns:c="clr-namespace:EzTorrent.Desktop.Controls"
  Title="{l:Loc Preferences}" Width="560" Height="740" MinHeight="480" MinWidth="480" WindowStartupLocation="CenterOwner"
  Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,16">
        <TextBlock x:Name="Heading" Text="{l:Loc Preferences}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock x:Name="Introduction" Text="{l:Loc WelcomeBody}" TextWrapping="Wrap" Margin="0,0,0,20" Visibility="Collapsed" />
        <Label Content="{l:Loc Theme}" Target="{Binding ElementName=ThemeBox}" Padding="0,0,0,6" />
        <ComboBox x:Name="ThemeBox" SelectedValuePath="Tag" Margin="0,0,0,16">
          <ComboBoxItem Content="{l:Loc System}" Tag="System" /><ComboBoxItem Content="{l:Loc Light}" Tag="Light" /><ComboBoxItem Content="{l:Loc Dark}" Tag="Dark" />
        </ComboBox>
        <Label Content="{l:Loc Language}" Target="{Binding ElementName=LanguageBox}" Padding="0,0,0,6" />
        <ComboBox x:Name="LanguageBox" SelectedValuePath="Tag">
          <ComboBoxItem Content="{l:Loc System}" Tag="" /><ComboBoxItem Content="Português (Brasil)" Tag="pt-BR" /><ComboBoxItem Content="English (United States)" Tag="en-US" />
        </ComboBox>
        <TextBlock Text="{l:Loc RestartHint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,16" />
        <Label Content="{l:Loc DownloadFolder}" Target="{Binding ElementName=FolderBox}" Padding="0,0,0,6" />
        <DockPanel><Button DockPanel.Dock="Right" Content="{l:Loc Browse}" Click="BrowseFolder" Margin="8,0,0,0" /><TextBox x:Name="FolderBox" VerticalContentAlignment="Center" /></DockPanel>
        <TextBlock Text="{l:Loc FolderHint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,16" />
        <Label Content="{l:Loc CloseBehavior}" Target="{Binding ElementName=CloseBox}" Padding="0,0,0,6" />
        <ComboBox x:Name="CloseBox" SelectedValuePath="Tag" Margin="0,0,0,20">
          <ComboBoxItem Content="{l:Loc Ask}" Tag="Ask" /><ComboBoxItem Content="{l:Loc Exit}" Tag="Exit" /><ComboBoxItem Content="{l:Loc Minimize}" Tag="Minimize" />
        </ComboBox>
        <CheckBox Content="{l:Loc Telemetry}" IsChecked="False" IsEnabled="False" />
        <TextBlock Text="{l:Loc TelemetryHint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" />
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,16,0,0" AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="{l:Loc Cancel}" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
      <Button x:Name="SaveButton" Content="{l:Loc Save}" Click="SavePreferences" IsDefault="True" MinWidth="90" />
    </StackPanel>
  </Grid>
</c:AppWindow>
