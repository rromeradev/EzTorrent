<c:AppWindow x:Class="EzTorrent.Desktop.Views.FolderPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:EzTorrent.Desktop.Controls" xmlns:l="clr-namespace:EzTorrent.Desktop.Localization"
 Title="{l:Loc ChooseFolder}" Width="680" Height="540" MinWidth="480" MinHeight="360" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <Grid Margin="24,12,24,24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <DockPanel x:Name="Navigation" Margin="0,0,0,16">
     <Button DockPanel.Dock="Left" Content="{l:Loc Computer}" Click="ShowDrives" Margin="0,0,8,0" />
     <Button DockPanel.Dock="Left" Content="↑" AutomationProperties.Name="{l:Loc ParentFolder}" ToolTip="{l:Loc ParentFolder}" Click="GoUp" Margin="0,0,8,0" />
     <TextBox x:Name="LocationBox" AutomationProperties.Name="{l:Loc Location}" KeyDown="LocationKeyDown" TextChanged="LocationTextChanged" VerticalContentAlignment="Center" />
   </DockPanel>
   <ListBox x:Name="Folders" Grid.Row="1" MouseDoubleClick="EnterFolder" KeyDown="FolderKeyDown" AutomationProperties.Name="{l:Loc ChooseFolder}" HorizontalContentAlignment="Stretch">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="8"><TextBlock Text="▣" Margin="0,0,12,0" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" /><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock x:Name="ErrorText" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
   <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
     <Button Content="{l:Loc Cancel}" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
     <Button x:Name="SelectButton" Content="{l:Loc UseFolder}" IsDefault="True" Click="SelectFolder" MinWidth="110" />
   </StackPanel>
 </Grid>
</c:AppWindow>
